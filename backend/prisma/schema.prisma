generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SaleType {
  SHOP
  TRUCK
}

enum StockTxType {
  IN
  OUT
  DISPATCH
  RETURN
  ADJUSTMENT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum OrderStatus {
  INQUIRY
  QUOTATION_SENT
  CONFIRMED
  DELIVERED
  PAID
  CANCELLED
}

enum PaymentType {
  ADVANCE
  BALANCE
  FULL
}

enum ExpenseCategoryType {
  SALARY
  INCENTIVE
  ELECTRICITY
  RENT
  MAINTENANCE
  TRANSPORT
  MISC
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  location  String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users      User[]
  trucks     Truck[]
  sales      Sale[]
  expenses   Expense[]
  bulkOrders BulkOrder[]
  stockTx    StockTransaction[]
  customers  Customer[]
}

model Truck {
  id          Int      @id @default(autoincrement())
  name        String
  plateNumber String?
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users    User[]
  sessions TruckSession[]
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  email     String   @default("")
  password  String
  photo     String?
  role      String   @default("SALES")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  truckId   Int?
  truck     Truck?   @relation(fields: [truckId], references: [id])
  saleType  SaleType @default(SHOP)

  sales    Sale[]
  sessions TruckSession[]
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  emoji           String   @default("🍦")
  imageUrl        String?
  sellingPrice    Float    @default(0)
  costPerUnit     Float    @default(0)
  piecesPerPacket Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  purchases      Purchase[]
  sales          Sale[]
  stockTx        StockTransaction[]
  dispatches     TruckDispatch[]
  returns        TruckReturn[]
  bulkOrderItems BulkOrderItem[]
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Purchase {
  id           Int      @id @default(autoincrement())
  date         DateTime
  productId    Int
  product      Product  @relation(fields: [productId], references: [id])
  manufacturer String   @default("")
  quantity     Float
  costPerUnit  Float
  totalCost    Float
  notes        String?
  createdAt    DateTime @default(now())
}

model StockTransaction {
  id        Int         @id @default(autoincrement())
  type      StockTxType
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  branchId  Int?
  branch    Branch?     @relation(fields: [branchId], references: [id])
  quantity  Float
  notes     String?
  createdAt DateTime    @default(now())
}

// ─── Truck Operations ─────────────────────────────────────────────────────────

model TruckSession {
  id        Int           @id @default(autoincrement())
  truckId   Int
  truck     Truck         @relation(fields: [truckId], references: [id])
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  date      DateTime      @default(now())
  status    SessionStatus @default(OPEN)
  notes     String?
  createdAt DateTime      @default(now())

  dispatches TruckDispatch[]
  returns    TruckReturn[]
  sales      Sale[]
}

model TruckDispatch {
  id        Int          @id @default(autoincrement())
  sessionId Int
  session   TruckSession @relation(fields: [sessionId], references: [id])
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Float
  createdAt DateTime     @default(now())
}

model TruckReturn {
  id        Int          @id @default(autoincrement())
  sessionId Int
  session   TruckSession @relation(fields: [sessionId], references: [id])
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Float
  createdAt DateTime     @default(now())
}

// ─── Sales ────────────────────────────────────────────────────────────────────

model Sale {
  id           Int       @id @default(autoincrement())
  date         DateTime
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  quantity     Float
  pricePerUnit Float
  totalRevenue Float
  avgCostUnit  Float
  profit       Float
  saleType     SaleType  @default(SHOP)
  branchId     Int?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  sessionId    Int?
  session      TruckSession? @relation(fields: [sessionId], references: [id])
  notes        String?
  createdAt    DateTime  @default(now())
}

// ─── Expenses ─────────────────────────────────────────────────────────────────

model Expense {
  id         Int                 @id @default(autoincrement())
  branchId   Int
  branch     Branch              @relation(fields: [branchId], references: [id])
  category   ExpenseCategoryType
  amount     Float
  month      Int
  year       Int
  notes      String?
  createdAt  DateTime            @default(now())
}

// ─── Bulk Orders ──────────────────────────────────────────────────────────────

model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  email     String?
  address   String   @default("")
  city      String   @default("")
  gstin     String?
  notes     String?
  isActive  Boolean  @default(true)
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())

  bulkOrders BulkOrder[]
}

model BulkOrder {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  customerName  String
  customerPhone String?
  customerEmail String?
  eventDate     DateTime?
  branchId      Int
  branch        Branch      @relation(fields: [branchId], references: [id])
  customerId    Int?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  discount      Float       @default(0)
  status        OrderStatus @default(INQUIRY)
  notes         String?
  totalAmount   Float       @default(0)
  paidAmount    Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items    BulkOrderItem[]
  payments Payment[]
}

model BulkOrderItem {
  id           Int       @id @default(autoincrement())
  orderId      Int
  order        BulkOrder @relation(fields: [orderId], references: [id])
  productId    Int
  product      Product   @relation(fields: [productId], references: [id])
  quantity     Float
  pricePerUnit Float
  totalPrice   Float
}

model Payment {
  id      Int         @id @default(autoincrement())
  orderId Int
  order   BulkOrder   @relation(fields: [orderId], references: [id])
  amount  Float
  type    PaymentType
  notes   String?
  paidAt  DateTime    @default(now())
}

// ─── Role Permissions ─────────────────────────────────────────────────────────

model RolePermission {
  id        Int     @id @default(autoincrement())
  role      String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([role, module])
}

// ─── Company / Invoice Settings ───────────────────────────────────────────────

model CompanySetting {
  id              Int      @id @default(autoincrement())
  companyName     String   @default("")
  tagline         String   @default("")
  logoUrl         String?
  address         String   @default("")
  city            String   @default("")
  state           String   @default("")
  pincode         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  website         String   @default("")
  gstin           String   @default("")
  fssai           String   @default("")
  bankName        String   @default("")
  bankAccount     String   @default("")
  bankIfsc        String   @default("")
  bankAccountName String   @default("")
  invoicePrefix   String   @default("INV")
  invoiceTerms    String   @default("Thank you for your business!")
  updatedAt       DateTime @updatedAt
}

// ─── Custom Roles ─────────────────────────────────────────────────────────────

model CustomRole {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  label     String
  color     String   @default("#6B7280")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
